---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortedComics } from '../lib/comics';

const comics = sortedComics(await getCollection('comics'));
---
<BaseLayout title="Archive">
  <h1>Archive</h1>
  <ol class="archive-grid">
    {comics.map(({ data: comic }) => (
      <li>
        <a href={`/comic/${comic.comicNumber}`}>
          <img src={comic.image} alt={comic.altText} loading="lazy" />
          <p class="eyebrow">Comic #{comic.comicNumber}</p>
          <h2>{comic.title}</h2>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>
<style>
  h1 { margin: 0 0 1.5rem; }
  .archive-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; list-style: none; padding: 0; margin: 0 0 2rem; }
  li { min-width: 0; }
  .archive-grid a { display: block; height: 100%; padding: 0.6rem 0.6rem 0.9rem; background: var(--surface); border: 1px solid var(--line); color: var(--fg); text-decoration: none; overflow-wrap: anywhere; transition: border-color 0.1s; }
  .archive-grid a:hover { border-color: var(--accent); }
  .archive-grid a:hover h2 { color: var(--accent-text); }
  img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: contain; background: var(--bg); }
  .eyebrow { margin: 0.75rem 0 0.1rem; }
  h2 { font-size: 1.15rem; margin: 0; }
  @media (max-width: 48rem) { .archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .archive-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .archive-grid a { transition: none; } }
</style>
