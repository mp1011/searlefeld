---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortedComics } from '../lib/comics';
import { formatPublishDate } from '../lib/dates';

const comics = sortedComics(await getCollection('comics'));
---
<BaseLayout title="Archive">
  <h1>Archive</h1>
  <ol class="archive-grid">
    {comics.map(({ data: comic }) => (
      <li>
        <a href={`/comic/${comic.comicNumber}`}>
          <img src={comic.image} alt={comic.altText} loading="lazy" />
          <h2>#{comic.comicNumber} — {comic.title}</h2>
          <time datetime={comic.publishDate.toISOString().slice(0, 10)}>{formatPublishDate(comic.publishDate)}</time>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>
<style>
  .archive-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; list-style: none; padding: 0; margin: 0 0 2rem; }
  li { min-width: 0; }
  .archive-grid a { display: block; height: 100%; border: 1px solid var(--border); padding: 1rem; border-radius: 0.25rem; text-decoration: none; overflow-wrap: anywhere; }
  .archive-grid a:hover h2 { text-decoration: underline; }
  .archive-grid a:focus-visible { outline: 3px solid var(--link); outline-offset: 3px; }
  img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: contain; }
  h2 { font-size: 1.125rem; margin: 1rem 0 0.5rem; }
  time { color: var(--muted); }
  @media (max-width: 48rem) { .archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .archive-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
