---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ComicViewer from '../components/ComicViewer.astro';
import ComicNav from '../components/ComicNav.astro';
import { latest, sortedComics } from '../lib/comics';

const all = await getCollection('comics');
const comic = latest(all);
const numbers = sortedComics(all).map((c) => c.data.comicNumber);
if (!comic) throw new Error('No comics found');
---
<BaseLayout>
  <ComicViewer
    number={comic.data.comicNumber}
    title={comic.data.title}
    image={comic.data.image}
    altText={comic.data.altText}
    hoverText={comic.data.hoverText}
    publishDate={comic.data.publishDate}
    transcript={comic.body}
  >
    <ComicNav slot="nav" numbers={numbers} current={comic.data.comicNumber} />
    <ComicNav numbers={numbers} current={comic.data.comicNumber} />
  </ComicViewer>
</BaseLayout>

