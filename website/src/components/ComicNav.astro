---
import { navTargets } from '../lib/comics';
interface Props { numbers: number[]; current: number }
const { numbers, current } = Astro.props;
const t = navTargets(numbers, current);
const others = numbers.filter((n) => n !== current);
const randomFallback = others.length ? others[0] : current;
const buttons = [
  { key: 'first', label: '|<<', word: 'First', name: 'First comic', target: t.first },
  { key: 'prev', label: '<', word: 'Prev', name: 'Previous comic', target: t.prev },
  { key: 'next', label: '>', word: 'Next', name: 'Next comic', target: t.next },
  { key: 'latest', label: '>>|', word: 'Latest', name: 'Latest comic', target: t.latest },
];
---
<nav class="comic-nav" aria-label="Comic navigation" data-numbers={JSON.stringify(numbers)} data-current={current}>
  {buttons.slice(0, 2).map((b) => b.target === null
    ? <span class="disabled" aria-disabled="true" aria-label={b.name}><span aria-hidden="true">{b.label}</span><span class="word">{b.word}</span></span>
    : <a href={`/comic/${b.target}`} aria-label={b.name} data-nav={b.key}><span aria-hidden="true">{b.label}</span><span class="word">{b.word}</span></a>)}
  <a href={`/comic/${randomFallback}`} aria-label="Random comic" data-nav="random" class="random"><span aria-hidden="true">?</span><span class="word">Random</span></a>
  {buttons.slice(2).map((b) => b.target === null
    ? <span class="disabled" aria-disabled="true" aria-label={b.name}><span class="word">{b.word}</span><span aria-hidden="true">{b.label}</span></span>
    : <a href={`/comic/${b.target}`} aria-label={b.name} data-nav={b.key}><span class="word">{b.word}</span><span aria-hidden="true">{b.label}</span></a>)}
</nav>
<script>
  import { randomExcluding } from '../lib/comics';
  const nav = document.querySelector<HTMLElement>('.comic-nav');
  if (nav) {
    const numbers: number[] = JSON.parse(nav.dataset.numbers ?? '[]');
    const current = Number(nav.dataset.current);
    document.querySelectorAll<HTMLAnchorElement>('.comic-nav [data-nav="random"]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        location.href = `/comic/${randomExcluding(numbers, current, Math.random)}`;
      }),
    );
    document.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      const key = e.key === 'ArrowLeft' ? 'prev' : e.key === 'ArrowRight' ? 'next' : null;
      if (key) nav.querySelector<HTMLAnchorElement>(`[data-nav="${key}"]`)?.click();
    });
  }
</script>
<style>
  .comic-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
  .comic-nav a, .comic-nav .disabled {
    display: inline-flex; gap: 0.4em; align-items: center; justify-content: center; min-width: 2.75rem; padding: 0.35rem 0.75rem;
    font-family: var(--mono); font-size: 0.85rem; font-weight: 600; text-decoration: none;
    color: var(--accent-text); border: 1.5px solid var(--accent); transition: background-color 0.1s, color 0.1s;
  }
  .comic-nav a:hover { background: var(--accent-text); border-color: var(--accent-text); color: var(--accent-ink); }
  .comic-nav .random { color: var(--sage); border-color: var(--sage); }
  .comic-nav .random:hover { background: var(--sage); border-color: var(--sage); color: var(--accent-ink); }
  .comic-nav .disabled { color: var(--muted); border-color: var(--line); cursor: not-allowed; }
  @media (max-width: 34rem) { .comic-nav .word { display: none; } }
  @media (prefers-reduced-motion: reduce) { .comic-nav a { transition: none; } }
</style>
