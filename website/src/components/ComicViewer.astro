---
interface Props {
  title: string;
  image: string;
  altText: string;
  hoverText?: string;
  transcript?: string;
}
const { title, image, altText, hoverText, transcript } = Astro.props;
const paragraphs = (transcript ?? '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
---
<article class="comic">
  <h1>{title}</h1>
  <img src={image} alt={altText} title={hoverText} />
  <details class="transcript">
    <summary>Transcript</summary>
    {paragraphs.map((p) => <p>{p}</p>)}
  </details>
</article>
<style>
  .comic { text-align: center; }
  .transcript { text-align: left; margin-top: 1rem; }
  summary { cursor: pointer; font-weight: 600; }
</style>
