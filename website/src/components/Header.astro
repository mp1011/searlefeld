---
import SiteBanner from './SiteBanner.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/archive', label: 'Archive' },
  { href: '/about', label: 'About' },
];
---
<SiteBanner />
<header class="site-header">
  <nav aria-label="Main">
    {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
    <a class="rss" href="/rss.xml">RSS</a>
  </nav>
</header>
<style>
  .site-header { background: var(--surface); border-block: 1px solid var(--line); }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.5rem; padding: 0.6rem 1rem; font-family: var(--mono); font-size: 0.9rem; }
  a { color: var(--fg); text-decoration: none; }
  a::before { content: '> '; color: var(--line); }
  a:hover { color: var(--accent-text); }
  a[aria-current="page"] { color: var(--accent-text); font-weight: 600; }
  a[aria-current="page"]::before, a:hover::before { color: var(--accent); }
  .rss { margin-left: auto; }
  @media (max-width: 30rem) { nav { gap: 0.25rem 1rem; } }
</style>
