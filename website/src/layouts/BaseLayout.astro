---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildMeta } from '../lib/meta';
import { themeCss } from '../lib/theme';
import '@fontsource/fredoka/600.css';
import '@fontsource/fredoka/700.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import type { ComicEntry } from '../lib/comics';
interface Props { title?: string; description?: string; image?: string; comic?: ComicEntry }
const site = Astro.site!;
const defaults = buildMeta(Astro.props.comic ?? null, site);
const { title = defaults.title, description = defaults.description, image = defaults.image } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <style is:inline set:html={themeCss()}></style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:url" content={new URL(Astro.url.pathname, site).href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Searlefeld RSS" href={new URL('/rss.xml', site).href} />
  </head>
  <body>
    <Header />
    <main class="content"><slot /></main>
    <Footer />
  </body>
</html>
<style is:global>
  :root {
    --max-width: 60rem;
    --display: 'Fredoka', 'Nunito', system-ui, sans-serif;
    --body: 'Nunito', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; background: var(--bg); color: var(--fg); font-family: var(--body); line-height: 1.55; }
  h1, h2, h3 { font-family: var(--display); font-weight: 700; line-height: 1.2; text-wrap: balance; }
  a { color: var(--accent-text); text-underline-offset: 0.2em; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .content { flex: 1; width: 100%; max-width: var(--max-width); margin: 0 auto; padding: 1.5rem 1rem 2rem; }
  img { max-width: 100%; height: auto; }
  .eyebrow { font-family: var(--mono); font-size: 0.8rem; color: var(--sage); letter-spacing: 0.02em; }
</style>
