---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string }
const { title } = Astro.props;
const pageTitle = title ? `${title} | Searlefeld` : 'Searlefeld';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main class="content"><slot /></main>
    <Footer />
  </body>
</html>
<style is:global>
  :root {
    --bg: #ffffff; --fg: #1a1a1a; --muted: #555555; --border: #dddddd; --link: #0b5cad;
    --max-width: 60rem;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #121212; --fg: #eeeeee; --muted: #aaaaaa; --border: #333333; --link: #7db8f0; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; background: var(--bg); color: var(--fg); font-family: system-ui, sans-serif; line-height: 1.5; }
  a { color: var(--link); }
  .content { flex: 1; width: 100%; max-width: var(--max-width); margin: 0 auto; padding: 1rem; }
  img { max-width: 100%; height: auto; }
</style>
